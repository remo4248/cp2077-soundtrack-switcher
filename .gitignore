tools/prepare/*.obj
/plugin/build/
/plugin/deps/
tools/*.exe
tools/*.obj
dist/

# MO2 / local
tmp_disabled/
crashdumps/

# Python cache
__pycache__/
*.pyc

# AudioXL's own starter download (third-party, not ours to redistribute)
/README.txt
/listOn.txt
/records.audio_metadata
/r6/storages/

