+bool SoundRegistry::SetRowEnabled(const std::string& aName, bool aEnabled) {
+  if (!m_ready || !m_names || !m_count) return false;
+  std::lock_guard lock(m_mutex);
+  const uint16_t rows = *m_count;
+  for (uint16_t row = 0; row < rows && row < m_specs.size(); ++row) {
+    if (!m_specs[row].valid || m_specs[row].name != aName) continue;
+    const auto held = m_disabledNames.find(row);
+    if (aEnabled) {
+      if (held == m_disabledNames.end()) return true;   // already on
+      m_names[row] = held->second;
+      m_disabledNames.erase(held);
+    } else {
+      if (held != m_disabledNames.end()) return true;   // already off
+      m_disabledNames[row] = m_names[row];
+      m_names[row] = 0;
+      AudioFeed::Get()->Stop(row, 0.0f);                // whatever it is playing stops now
+    }
+    return true;
+  }
+  return false;
+}
