+    Tick();
+    Red::DynArray<Red::CName> out;
+    auto* reg = SoundRegistry::Get();
+    auto* feed = AudioFeed::Get();
+    const int32_t count = reg->Count();
+    for (int32_t r = 0; r < count; ++r) {
+      const auto row = static_cast<uint16_t>(r);
+      if (!feed->IsPlaying(row)) continue;
+      const SoundSpec* spec = reg->SpecForRow(row);
+      if (spec && spec->valid && !spec->name.empty()) {
+        out.PushBack(RED4ext::CNamePool::Add(spec->name.c_str()));
+      }
+    }
+    return out;
+  }
